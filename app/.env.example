# CastView — copy to app/.env.local for local dev; set the same keys on Vercel for production.

# Supabase (client)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Supabase (server / API routes)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI evaluations
ANTHROPIC_API_KEY=your_anthropic_key

# Email (outbound + inbound webhook)
RESEND_API_KEY=your_resend_key
RESEND_FROM_EMAIL=team@castview.org
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# Stripe billing
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SOLO_PRICE_ID=price_...
STRIPE_STUDIO_PRICE_ID=price_...
STRIPE_AGENCY_PRICE_ID=price_...

# Optional: enable /api/auth-debug outside local dev
# CASTVIEW_ENABLE_DEBUG=1
